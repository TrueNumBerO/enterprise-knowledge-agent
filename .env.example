# DeepSeek Flash 本地配置：只需在下一行等号后粘贴你的 API Key。
# 本文件会被 Git 忽略；不要把密钥填入 docs 中的说明文档。
KB_AGENT_API_KEY=
KB_AGENT_BASE_URL=https://api.deepseek.com
KB_AGENT_MODEL=deepseek-flash
KB_AGENT_TIMEOUT=60

# live 模式自动读取本项目根目录 .env；Mock 不读取、不调用外部模型。
# 进程环境变量优先于本文件（包括空值）；没有旧环境变量时直接使用这里的配置。
# 格式为 KEY=VALUE；支持整行 # 注释及成对引号；不要在值后加注释。
